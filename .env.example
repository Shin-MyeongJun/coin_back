APP_ENV=local

# Spring application infrastructure
APP_DB_URL=jdbc:postgresql://localhost:5432/coin_data?reWriteBatchedInserts=true
APP_DB_NAME=coin_data
APP_DB_USERNAME=db_manager
APP_DB_PASSWORD=change-me
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# API/auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=300
JWT_REFRESH_TTL=1209600
JWT_ISSUER=ys-coin
API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# External API keys
FRED_API_KEY=
UPBIT_OPEN_API_ACCESS_KEY=
UPBIT_OPEN_API_SECRET_KEY=
BINANCE_OPEN_API_ACCESS_KEY=
BINANCE_OPEN_API_SECRET_KEY=

# Optional runtime flags
FLYWAY_ENABLED=true
JPA_DDL_AUTO=update
MANAGEMENT_PROMETHEUS_ENABLED=true
